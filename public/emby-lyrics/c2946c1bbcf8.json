{"synced":[{"time":3,"text":""},{"time":17.26,"text":"十年后的今天遇见你"},{"time":21.25,"text":"年少轻狂已远去"},{"time":25.15,"text":"成熟稳重也保持距离"},{"time":29,"text":"沉默里千言万语"},{"time":32.61,"text":""},{"time":33.59,"text":"时光回到那年夏天"},{"time":37.34,"text":"公车站前你笑容满面"},{"time":41.43,"text":"拍拍我的头说你好吗"},{"time":47.08,"text":""},{"time":49.01,"text":"一句问候填满青春"},{"time":52.9,"text":"别人的话都听不见"},{"time":56.11,"text":"岁月凝结在你的视线"},{"time":60.48,"text":""},{"time":60.97,"text":"我还记得那年倾盆大雨"},{"time":65.79,"text":"狼狈奔跑穿越几条街"},{"time":69.62,"text":"握紧的双手"},{"time":71.57,"text":"为爱的不顾一切"},{"time":76.41,"text":"我还记得那年你的声音"},{"time":81.19,"text":"耳边回荡那一句誓言"},{"time":85.08,"text":"你吻我的脸都是我心中"},{"time":88.88,"text":"收藏一生的快乐"},{"time":93.59,"text":""},{"time":108.95,"text":""},{"time":115.97,"text":"渐渐我们都有新朋友"},{"time":119.83,"text":"多久不再并肩走"},{"time":123.76,"text":"忙忙碌碌看人生匆匆"},{"time":127.63,"text":"忘记了年轻的梦"},{"time":131.18,"text":""},{"time":132.3,"text":"好想回到那年夏天"},{"time":136.05,"text":"教室门前你笑容满面"},{"time":139.99,"text":"拍拍我的头说你别哭"},{"time":145.34,"text":""},{"time":147.69,"text":"考坏一次不是末日"},{"time":151.52,"text":"未来还有很长的路"},{"time":154.67,"text":"我们要一起去看世界"},{"time":159.06,"text":""},{"time":159.53,"text":"[03:29.76]我还记得那年晴空万里"},{"time":170.15,"text":"[03:40.49]写下故事的总结"},{"time":174.87,"text":"[03:45.22]我还记得那年你的年轻"},{"time":179.81,"text":"[03:50.27]刻在从前最美的时间"},{"time":183.69,"text":"[03:54.10]在我生命里"},{"time":185.72,"text":"[03:56.05]你不曾告别"},{"time":187.66,"text":"[03:58.00]不曾走远"},{"time":192.4,"text":""},{"time":194.33,"text":"与你重逢前一个夜晚"},{"time":198.18,"text":"往事在梦中上演"},{"time":201.5,"text":"终要去体验"},{"time":203.38,"text":"真实人生的残缺"},{"time":208.99,"text":""},{"time":214.78,"text":"[02:44.33]那一道飞机云的弧线"},{"time":218.61,"text":"[02:48.24]蜿蜒着思念"},{"time":247.5,"text":"钢琴：Mac Chew"},{"time":248.55,"text":"吉他：Jamie Wilson"},{"time":249.6,"text":"鼓：Gary Gideon"},{"time":250.65,"text":"贝斯：David Yee"},{"time":251.65,"text":"弦乐演奏：八人行 (北京)"},{"time":253.87,"text":"[01:40.44]"},{"time":256.91,"text":"[01:4