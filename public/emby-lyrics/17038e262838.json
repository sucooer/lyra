{"synced":[{"time":0.74,"text":"“将来の夢は何なんですか”"},{"time":4.71,"text":"薄っぺらい紙にいつも苦しんだ。"},{"time":8.79,"text":"本当のこと誰にも言えなくて"},{"time":12.65,"text":"とりあえずママのお仕事って書いていた。"},{"time":25.59,"text":"“歌を歌いたい”"},{"time":27.78,"text":"“詩を書きたい”"},{"time":29.67,"text":"そんなの全人類の一握りだって"},{"time":33.63,"text":"分かっていたから"},{"time":35.66,"text":"気づいていたから"},{"time":37.6,"text":"歌いたいって文字は消しカスになってた。"},{"time":43.74,"text":"そんな中歌を歌うのは"},{"time":47.65,"text":"等身大な君だった。"},{"time":51.73,"text":"欲しいもの全部持ち合わせていた、"},{"time":55.7,"text":"君がそう、紺色。"},{"time":58.93,"text":"私を変えたくて、"},{"time":62.64,"text":"カメラ越しに詩を歌った。"},{"time":66.83,"text":"やってみなきゃ、"},{"time":68.62,"text":"当たって砕けなきゃ、"},{"time":71.48,"text":"分かんない。"},{"time":74.55,"text":"笑いたきゃ笑えばいい、"},{"time":78.65,"text":"それで幸せになれるんなら。"},{"time":82.65,"text":"恥ずかしくないよ、"},{"time":84.64,"text":"これが私の生き方だ。"},{"time":95.62,"text":"私はね、どんな詩も、"},{"time":99.71,"text":"自信がない子ばっか書いてるの。"},{"time":103.44,"text":"ほんと、ごめんね。"},{"time":105.67,"text":"次からはちゃんと"},{"time":107.8,"text":"自信がある子にしてあげるね。"},{"time":111.81,"text":"1人眠れない夜だって"},{"time":115.71,"text":"気づけばそこに歌があった。"},{"time":119.87,"text":"“明日はちゃんと来る”ってこと"},{"time":123.17,"text":"教えてくれたから。"},{"time":126.92,"text":"私を変えたくて、"},{"time":130.62,"text":"1人で生きるって決めたの。"},{"time":134.94,"text":"後悔だって"},{"time":136.61,"text":"挫折だって"},{"time":138.47,"text":"したくはないから。"},{"time":142.59,"text":"泣きたきゃ泣けばいい、"},{"time":146.62,"text":"それが前を向くためならば。"},{"time":150.78,"text":"恥ずかしくないよ、"},{"time":152.67,"text":"これが私の世界だ。"},{"time":171.15,"text":"あの日の私へ。"},{"time":173.1,"text":"上手な生き方ばかり"},{"time":175.78,"text":"考えていたあの時へ。"},{"time":179.16,"text":"私、今、"},{"time":181.68,"text":"下手だけど"},{"time":183.2,"text":"幸せな方を選んだよ。"},{"time":188.79,"text":"私を変えたくて、"},{"time":192.87,"text":"私は変わるから、"},{"time":196.68,"text":"今ここで詩を歌ってる。"},{"time":200.93,"text":"貴方に、"},{"time":202.59,"text":"ただ貴方に歌い続ける。"},{"time":208.69,"text":"好きなように生きればいい、"},{"time":212.76,"text":"私も好きなように生きるよ。"},{"time":216.59,"text":"恥ずかしくないね、"},{"time":218.65,"text":"これが私の詩だから。"}],"plain":null}