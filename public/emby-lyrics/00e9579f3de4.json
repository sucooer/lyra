{"synced":[{"time":2.04,"text":"吉他：周显哲"},{"time":6.09,"text":"(SP: Warner/Chappell Music Taiwan Ltd.)"},{"time":7.1,"text":""},{"time":32.96,"text":"争执在慢慢累积"},{"time":35.94,"text":"所以疲倦也默默累积"},{"time":39.29,"text":"侵蚀了爱情 坍塌了亲密"},{"time":46.76,"text":"心情在慢慢转移"},{"time":49.88,"text":"所以焦点也默默转移"},{"time":53.21,"text":"放大了问题 草草分离"},{"time":59.02,"text":"璀璨回忆 化为灰烬"},{"time":68.01,"text":"在冷静之后剩冷清"},{"time":75.01,"text":"太倔强的人 没资格惋惜"},{"time":81.75,"text":"若无其事 忍痛走下去"},{"time":88.9,"text":"在深夜喃喃自语"},{"time":91.35,"text":"没有人像你"},{"time":95.85,"text":"一句话就能带来"},{"time":98.18,"text":"天堂或地狱"},{"time":102.79,"text":"你太懂得我"},{"time":105.36,"text":"感动我从不费力"},{"time":109.76,"text":"要伤我就更容易 彻底"},{"time":140.76,"text":"最深刻那种感情"},{"time":143.91,"text":"就是最动荡那种感情"},{"time":147.15,"text":"虽然不安宁 却蕴藏惊喜"},{"time":152.9,"text":"两全其美 不会降临"},{"time":161.93,"text":"在冷静之后剩冷清"},{"time":168.91,"text":"太倔强的人 没资格惋惜"},{"time":175.44,"text":"若无其事 忍痛走下去"},{"time":182.85,"text":"在深夜喃喃自语"},{"time":185.06,"text":"没有人像你"},{"time":189.74,"text":"一句话就能带来"},{"time":191.94,"text":"天堂或地狱"},{"time":196.73,"text":"你太懂得我"},{"time":199.32,"text":"感动我从不费力"},{"time":203.69,"text":"要伤我就更容易"},{"time":210.62,"text":"像遗憾喃喃自语"},{"time":212.85,"text":"没有人像你"},{"time":217.54,"text":"让困境或是命运"},{"time":219.76,"text":"不值得忧虑"},{"time":224.51,"text":"不计划未来"},{"time":227.15,"text":"享受当下的美丽"},{"time":231.49,"text":"是任性还是勇气"},{"time":237.21,"text":"越哭泣 越生气"},{"time":252.22,"text":"多 嫉妒你爱恨都随意"},{"time":259.38,"text":"对日记喃喃自语"},{"time":261.62,"text":"没有人像你"},{"time":266.42,"text":"能那么自由"},{"time":268.9,"text":"想放开就能舍弃"},{"time":272.4,"text":"我恨我假忘记 却不停回忆"},{"time":280.19,"text":"像遗憾喃喃自语"},{"time":282.52,"text":"没有人像你"},{"time":287.14,"text":"让困境或是命运"},{"time":289.35,"text":"不值得忧虑"},{"time":294.11,"text":"不计划未来"},{"time":296.7,"text":"享受当下的美丽"},{"time":301.01,"text":"为何我无法随性 像你"}],"plain":null}