{"synced":[{"time":0,"text":"..."},{"time":12.24,"text":"頬に感じた冷たさは冬のせい"},{"time":23.92,"text":""},{"time":23.92,"text":"痩せた木は風に揺れながら"},{"time":29.85,"text":""},{"time":29.85,"text":"いつか来る春を待つ"},{"time":36.58,"text":""},{"time":36.58,"text":"滲んだ景色に"},{"time":42.28,"text":""},{"time":42.28,"text":"何度も俯きながらも"},{"time":48.69,"text":""},{"time":48.69,"text":"夢から覚める日を願っていた"},{"time":54.61,"text":""},{"time":54.61,"text":"小さな私がそこにいた"},{"time":61.11,"text":""},{"time":61.11,"text":"凍える肩にそっと触れた手を"},{"time":66.55,"text":""},{"time":66.55,"text":"あの日の私は知らなかった"},{"time":72.59,"text":""},{"time":72.59,"text":"その温かさを確かめるように"},{"time":78.98,"text":""},{"time":78.98,"text":"強く 強く抱きしめた"},{"time":87.6,"text":""},{"time":87.6,"text":"どうして ここにいたの"},{"time":93.3,"text":""},{"time":93.3,"text":"どうして 私に出逢ってくれたの"},{"time":100.37,"text":""},{"time":100.37,"text":"何もなかった"},{"time":103.83,"text":""},{"time":103.83,"text":"私の中にあなたがくれたものが溢れていく"},{"time":112.46,"text":""},{"time":112.46,"text":"もらった分だけあなたに返せるように"},{"time":124.68,"text":""},{"time":124.68,"text":"優しい背中に耳を当てながら"},{"time":131.93,"text":""},{"time":131.93,"text":"あなたを感じていた"},{"time":141.14,"text":""},{"time":144.46,"text":"無防備な寝顔を"},{"time":150.43,"text":""},{"time":150.43,"text":"静かに見つめていた夜"},{"time":156.68,"text":""},{"time":156.68,"text":"いつまでも傍にいたいと願う"},{"time":162.42,"text":""},{"time":162.42,"text":"素直な私がそこにいた"},{"time":169,"text":""},{"time":169,"text":"受け止めてくれた大きな胸も"},{"time":174.76,"text":""},{"time":174.76,"text":"繋いでくれた左手も"},{"time":180.38,"text":""},{"time":180.38,"text":"愛しい気持ちは零れていくのに"},{"time":186.65,"text":""},{"time":186.65,"text":"上手く言葉にできない"},{"time":195.18,"text":""},{"time":195.18,"text":"ありがとう ここにいてくれて"},{"time":201.5,"text":""},{"time":201.5,"text":"ありがとう 私に出逢ってくれて"},{"time":208.4,"text":""},{"time":208.4,"text":"何もなかった"},{"time":211.68,"text":""},{"time":211.68,"text":"私の中にあなたがくれたものが溢れていく"},{"time":220.14,"text":""},{"time":220.14,"text":"もらった分より もっともっと返せるように"},{"time":232.9,"text":""},{"time":232.9,"text":"あ