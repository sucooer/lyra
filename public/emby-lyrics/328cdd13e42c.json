{"synced":[{"time":0,"text":"..."},{"time":25.48,"text":"ほころんだ口元に 小さく浮かぶ微笑み"},{"time":30.97,"text":""},{"time":30.97,"text":"細くなるその目に優しさが滲んだ"},{"time":36.44,"text":""},{"time":36.44,"text":"誰にも見えないように"},{"time":39.23,"text":""},{"time":39.23,"text":"そっと拭った涙は"},{"time":42.8,"text":""},{"time":42.8,"text":"静かに胸の奥に隠したまま"},{"time":47.19,"text":""},{"time":47.19,"text":"好きな歌を口ずさんだり"},{"time":52.89,"text":""},{"time":52.89,"text":"晴れた日には空を眺めたり"},{"time":58.64,"text":""},{"time":58.64,"text":"そんな日常が続いていくことを"},{"time":65.77,"text":""},{"time":65.77,"text":"今あなたの笑顔に願った"},{"time":74.11,"text":""},{"time":74.11,"text":"例えば心細く長い夜は話をしよう"},{"time":85.2,"text":""},{"time":85.2,"text":"懐かしいこと たくさん笑ったこと 不安なことも"},{"time":93.76,"text":""},{"time":93.76,"text":"夜が明けるまで"},{"time":96.73,"text":""},{"time":96.73,"text":"ずっとそばで"},{"time":104.74,"text":""},{"time":104.74,"text":"生まれ育った場所 歩いてきた道"},{"time":110.11,"text":""},{"time":110.11,"text":"それぞれ違っても 出会えたこと"},{"time":115.41,"text":""},{"time":115.41,"text":"もしも意味があるなら"},{"time":118.1,"text":""},{"time":118.1,"text":"それはきっと喜びをこの道の先に見つけに行くこと"},{"time":126,"text":""},{"time":126,"text":"雨が降れば傘をさそう"},{"time":131.81,"text":""},{"time":131.81,"text":"目が覚めたなら朝日を見よう"},{"time":137.54,"text":""},{"time":137.54,"text":"行き止まったならまた道を探そう"},{"time":144.65,"text":""},{"time":144.65,"text":"強い風の吹く日は手を繋ごう"},{"time":157.32,"text":""},{"time":157.32,"text":"見せてくれた写真に映った"},{"time":162.44,"text":""},{"time":162.44,"text":"大切な人達や思い出の景色を"},{"time":167.84,"text":""},{"time":167.84,"text":"少し照れたように肩をすくめながら"},{"time":173.75,"text":""},{"time":173.75,"text":"指で優しくなぞった"},{"time":185.33,"text":""},{"time":185.33,"text":"例えば いつの日にか今日を語るあなたがいたなら"},{"time":196.14,"text":""},{"time":196.14,"text":"優しい光で包まれていますように"},{"time":203,"text":""},{"time":203,"text":"そんな未来がきっとくるから"},{"time":208.48,"text":""},{"time":208.48,"text":"例えば心細く長い夜は話をしよう"},{"time":219.54,"text":""},{"time":219.54,"text":"懐かしいこと たくさん笑ったこと 不安なことも"},{"time":228.33,"text":""},{"time":228.33,"text":"夜が明けるまで ずっとそばで"},{"time":237.74,"text":""}],"plain":null}