{"synced":[{"time":0,"text":"..."},{"time":6.33,"text":"同じ屋根の下 同じ天井を見て"},{"time":12.95,"text":""},{"time":12.95,"text":"明日を想いながら眠りにつく夜"},{"time":19.97,"text":""},{"time":19.97,"text":"時には小言を呟きながら"},{"time":25.88,"text":""},{"time":25.88,"text":"忙しなく身支度をする朝"},{"time":33.83,"text":""},{"time":33.83,"text":"繰り返す日々を退屈だと"},{"time":40.26,"text":""},{"time":40.26,"text":"思ったことなど一度もありません"},{"time":47.25,"text":""},{"time":47.25,"text":"ああ 洗濯物が今日も風に揺れている"},{"time":53.59,"text":""},{"time":53.59,"text":"あなたへ あなたへ 届けと"},{"time":62.78,"text":""},{"time":62.78,"text":"見上げれば澄んだ勿忘草色"},{"time":71.37,"text":""},{"time":71.37,"text":"綿菓子のような雲がただ一つ"},{"time":78.4,"text":""},{"time":78.4,"text":"静かに流れていきます"},{"time":83.47,"text":""},{"time":83.47,"text":"言葉数は足りないあなたでしたが"},{"time":91.88,"text":""},{"time":91.88,"text":"渡せるようにと繋いできたもの"},{"time":98.56,"text":""},{"time":98.56,"text":"あなたがくれた日常を"},{"time":103.87,"text":""},{"time":103.87,"text":"愛しています"},{"time":108.64,"text":""},{"time":108.64,"text":"..."},{"time":119.55,"text":""},{"time":119.55,"text":"擦りむいた膝に貼った絆創膏"},{"time":125.37,"text":""},{"time":125.37,"text":"優しい声 微笑む顔をそっと浮かべていた"},{"time":132.42,"text":""},{"time":132.42,"text":"どんな時も心を寄せ 守り続けてくれた"},{"time":139.39,"text":""},{"time":139.39,"text":"毎日を憶いながら"},{"time":148.64,"text":""},{"time":148.64,"text":"会えないのは少し寂しいですが"},{"time":156.71,"text":""},{"time":156.71,"text":"いつの間にかあなたに似てきた私を"},{"time":163.52,"text":""},{"time":163.52,"text":"どこかで見ていますか?"},{"time":169.4,"text":""},{"time":169.4,"text":"言葉数は足りないあなたでしたが"},{"time":177.55,"text":""},{"time":177.55,"text":"渡せるようにと繋いできたもの"},{"time":184.3,"text":""},{"time":184.3,"text":"あなたがくれた幸せを"},{"time":189.48,"text":""},{"time":189.48,"text":"生きています"},{"time":194.28,"text":""},{"time":198.2,"text":"窓の外に見える"},{"time":201.52,"text":""},{"time":201.52,"text":"優しい灯り"},{"time":205.2,"text":""},{"time":205.2,"text":"私もその灯りの一つです"},{"time":211.88,"text":""},{"time":211.88,"text":"見せたい景色や話したいことが"},{"time":218.19,"text":""},{"time":218.19,"text":"今日もまた 増えました"},{"time":225.3,"text":""},{"time":225.3,"text":"あなたは私の誇りです"},{"time":231.18,"text":""}],"plain":null}