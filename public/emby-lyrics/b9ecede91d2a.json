{"synced":[{"time":7.11,"text":"Lost in the mountains"},{"time":11.83,"text":"Far from the crowds"},{"time":15.46,"text":"We would wander together"},{"time":20.55,"text":"Walking for miles"},{"time":24.55,"text":"With the night still before us"},{"time":29.3,"text":"And day passing by"},{"time":33.46,"text":"I always remember your smile"},{"time":41.08,"text":""},{"time":43.4,"text":"Cool in the evening"},{"time":47.99,"text":"Warm in the sun"},{"time":52.06,"text":"Their clouds moving slowly"},{"time":56.98,"text":"Time was undone"},{"time":60.77,"text":"Yet the days fell before us"},{"time":65.32,"text":"And nights rolled on by"},{"time":70.12,"text":"I always remember your smile"},{"time":79.77,"text":"Every step and each moment"},{"time":83.86,"text":"Were all so worthwhile"},{"time":88.44,"text":"I always remember your smile"},{"time":97.04,"text":""},{"time":125.26,"text":"I always remember your smile"},{"time":133.92,"text":"And it's strange how for a moment"},{"time":138.56,"text":"The heavens were mine"},{"time":142.98,"text":"I always remember your smile"},{"time":152.56,"text":"Each one has a journey"},{"time":157.05,"text":"That's how it goes"},{"time":161.23,"text":"Sometimes we're together"},{"time":166.14,"text":"Sometimes alone"},{"time":172.8,"text":""}],"plain":null}