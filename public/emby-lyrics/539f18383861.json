{"synced":[{"time":0,"text":"..."},{"time":16.7,"text":"手を振った後の道が寂しくなるのは"},{"time":21.42,"text":""},{"time":21.42,"text":"君の背中が遠くなっていくほど"},{"time":28,"text":""},{"time":28,"text":"また一人きりの世界に戻っていくから"},{"time":34.73,"text":""},{"time":34.73,"text":"本当は弱くて なんて情けないから"},{"time":40.54,"text":""},{"time":40.54,"text":"言えないけど でも君はきっと"},{"time":47.15,"text":""},{"time":47.15,"text":"そんな私のこと随分前から知ってたかな"},{"time":56.79,"text":""},{"time":56.79,"text":"点いては消える街灯を見てた"},{"time":62.52,"text":""},{"time":62.52,"text":"心許ない灯りの中"},{"time":68,"text":""},{"time":68,"text":"行き場を失くした冷たい右手を"},{"time":75.32,"text":""},{"time":75.32,"text":"握ってくれた君の手が優しかった"},{"time":81.12,"text":""},{"time":81.12,"text":"10年後の私はちゃんと笑えてるかな"},{"time":87.64,"text":""},{"time":87.64,"text":"今日まで流した涙の分も"},{"time":94.21,"text":""},{"time":94.21,"text":"拭いきれない弱さも君がくれた強さも"},{"time":100.29,"text":""},{"time":100.29,"text":"胸の奥 抱きしめていよう"},{"time":106.93,"text":""},{"time":106.93,"text":"..."},{"time":120.3,"text":""},{"time":120.3,"text":"「僕も同じだよ」初めて君が零した"},{"time":125.83,"text":""},{"time":125.83,"text":"たくさんの後悔や痛みが"},{"time":132.36,"text":""},{"time":132.36,"text":"小さな振動と共に私の肩に届いた"},{"time":141.69,"text":""},{"time":141.69,"text":"街ですれ違う人たちも"},{"time":147.83,"text":""},{"time":147.83,"text":"今隣にいてくれる君も"},{"time":153,"text":""},{"time":153,"text":"乗り越えてきた苦しみや傷痕を"},{"time":160.33,"text":""},{"time":160.33,"text":"両手に抱えながら生きているのかな"},{"time":166.85,"text":""},{"time":166.85,"text":"丸い背中を二つ並べた夜の空に"},{"time":173.13,"text":""},{"time":173.13,"text":"指で小さな夢を描いてみる"},{"time":179.42,"text":""},{"time":179.42,"text":"熱くなっていく手を君に握り返して"},{"time":185.78,"text":""},{"time":185.78,"text":"もう一度 小さく願った"},{"time":192.44,"text":""},{"time":192.44,"text":"躓きながら"},{"time":195.14,"text":""},{"time":195.14,"text":"立ち止まりながら"},{"time":198.69,"text":""},{"time":198.69,"text":"ゆっくりと歩いていく"},{"time":207.83,"text":""},{"time":207.83,"text":"10年前にここで見上げた夜の空を"},{"time":214.18,"text":""},{"time":214.18,"text":"思い出しながら笑おう"},{"time":220.41,"text":""},{"time":220.41,"text":"「タイムマシーンがあったら教えてあげたいよ」と"},{"time":226.75,"text":""},{"time":226.75,"text":"また君とこの場所で笑ってる"},{"time":233.1,"text":""},{"time":233.1,"text":"胸の奥 抱きしめていよう"},{"time":240.2,"text":""}],"plain":null}