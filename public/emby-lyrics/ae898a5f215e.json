{"synced":[{"time":0,"text":"..."},{"time":13.7,"text":"そっと重ねてみた"},{"time":19,"text":""},{"time":19,"text":"だけどもはみ出した"},{"time":22.27,"text":""},{"time":22.27,"text":"端の方だけ破った"},{"time":27.5,"text":""},{"time":27.5,"text":"だけどあなたはそのままでいいと"},{"time":32.86,"text":""},{"time":32.86,"text":"散らかった欠片をもう一度繋いで"},{"time":40.5,"text":""},{"time":40.5,"text":"直してくれた"},{"time":42.11,"text":""},{"time":42.11,"text":"心は紙一重"},{"time":46.9,"text":""},{"time":46.9,"text":"交わりそうで交わらないものだね"},{"time":54,"text":""},{"time":54,"text":"だからこそ今こんな風に寄り添い合って"},{"time":60.95,"text":""},{"time":60.95,"text":"その心を感じていたい ah"},{"time":71.83,"text":""},{"time":71.83,"text":"いつの日も 明ける明日を待って"},{"time":78,"text":""},{"time":78,"text":"儚い夢に焦がれて"},{"time":81.12,"text":""},{"time":81.12,"text":"あなたは誰かを今日も想いながら"},{"time":88.12,"text":""},{"time":88.12,"text":"胸に抱いた願い 追い続けるのでしょう"},{"time":95.43,"text":""},{"time":95.43,"text":"いつかその声が届きますように"},{"time":103.41,"text":""},{"time":103.41,"text":"..."},{"time":117.86,"text":""},{"time":117.86,"text":"もっと もっと 強くなれたら"},{"time":125.19,"text":""},{"time":125.19,"text":"心の奥 ずっとずっと変わりたかった"},{"time":132.33,"text":""},{"time":132.33,"text":"今の私はあなたのため何ができるだろう"},{"time":148.22,"text":""},{"time":148.22,"text":"触れたら壊れそうなほど"},{"time":154.62,"text":""},{"time":154.62,"text":"まっすぐな瞳 その奥に見た孤独"},{"time":162.84,"text":""},{"time":162.84,"text":"握る手が作る服の皺が"},{"time":168.72,"text":""},{"time":168.72,"text":"その叫びを伝えていた ah"},{"time":179.67,"text":""},{"time":179.67,"text":"いつの日も"},{"time":181.66,"text":""},{"time":181.66,"text":"迷いもがくことを"},{"time":185.25,"text":""},{"time":185.25,"text":"時に抗う強さを"},{"time":189,"text":""},{"time":189,"text":"あなたは私に教えてくれたね"},{"time":195.64,"text":""},{"time":195.64,"text":"心重ねた日々 知った光と影は"},{"time":202.97,"text":""},{"time":202.97,"text":"ずっとこの胸に息づいている"},{"time":209.86,"text":""},{"time":209.86,"text":"何度傷ついても"},{"time":213.25,"text":""},{"time":213.25,"text":"守り続けた愛が"},{"time":217.14,"text":""},{"time":217.14,"text":"いつかあなたを包みますように"},{"time":225.59,"