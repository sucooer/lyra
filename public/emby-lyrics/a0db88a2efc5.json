{"synced":[{"time":13.52,"text":"When you wish upon a star"},{"time":19.53,"text":"Makes no difference who you are"},{"time":26.09,"text":"Anything your heart desires"},{"time":32.38,"text":"Will come to you"},{"time":39.98,"text":"If your heart is in your dream"},{"time":46.35,"text":"No request is too extreme"},{"time":52.8,"text":"When you wish upon a star"},{"time":58.63,"text":"As dreamers do"},{"time":66.35,"text":"Fate is kind"},{"time":73.27,"text":"She brings to those who love"},{"time":79.69,"text":"The sweet fulfillment of"},{"time":84.78,"text":"Their secret longing"},{"time":98.1,"text":"Like a bolt out of the blue"},{"time":104.49,"text":"Fate steps in"},{"time":106.86,"text":"And sees you through"},{"time":111.04,"text":"When you wish upon a star"},{"time":116.69,"text":"Your dream comes true"},{"time":131.49,"text":""}],"plain":null}