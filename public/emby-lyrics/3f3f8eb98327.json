{"synced":[{"time":17.4,"text":"Picture me upon your knee"},{"time":24.48,"text":"Tea for two and two for tea"},{"time":31.24,"text":"Me for you"},{"time":33.4,"text":"And you for me alone"},{"time":43.36,"text":"Nobody near us"},{"time":46.48,"text":"To see us or hear us"},{"time":49.65,"text":"No friends or relations"},{"time":52.94,"text":"On weekend vacations"},{"time":56.94,"text":"We won't have it known"},{"time":59.66,"text":"That we own a telephone"},{"time":69.31,"text":"Day will break and you’ll awake"},{"time":76.31,"text":"And now we bake a sugar cake"},{"time":82.86,"text":"For you to take"},{"time":85.21,"text":"For all the boys to see"},{"time":95.27,"text":"We will raise a family"},{"time":101.54,"text":"A boy for you, and a girl for me"},{"time":108.74,"text":"Oh, can't you see"},{"time":111.2,"text":"How happy we would be"}],"plain":null}