{"synced":[{"time":0,"text":"给十年后的我 - 薛凯琪"},{"time":18.73,"text":"这十年来做过的事"},{"time":22.3,"text":"能令你无悔 骄傲吗"},{"time":26.87,"text":"那时候你所相信的事"},{"time":30.89,"text":"没有被动摇吧"},{"time":34.92,"text":"对象和缘份已出现"},{"time":38.66,"text":"成就也还算不赖吗"},{"time":43.16,"text":"旅途上你增添了经历"},{"time":47.02,"text":"又有让棱角 消失吗"},{"time":54.3,"text":"软弱吗"},{"time":57.59,"text":"你成熟了 不会失去格调吧"},{"time":62.76,"text":"当初坚持还在吗"},{"time":66.69,"text":"刀锋不会 磨钝了吧"},{"time":70.22,"text":"老练吗"},{"time":73.34,"text":"你情愿变得 聪明而不冲动吗"},{"time":78.33,"text":"但变成"},{"time":78.96,"text":"步步停下三思 会累吗"},{"time":97.64,"text":"快乐吗"},{"time":100.9,"text":"你还是记得你跟我约定吧"},{"time":105.94,"text":"区区几场成败里"},{"time":109.95,"text":"应该不致 麻木了吧"},{"time":113.41,"text":"快乐吗"},{"time":116.66,"text":"你忘掉理想 只能忙于生活吗"},{"time":121.46,"text":"别太迟"},{"time":122.37,"text":"又十年后至想 快乐吗"}],"plain":null}