{"synced":[{"time":3.68,"text":"Cold as the Northern winds"},{"time":12.08,"text":"In December morning"},{"time":14.56,"text":""},{"time":21.75,"text":"Cold is the cry that rings"},{"time":31.44,"text":"From this far distant shore"},{"time":38.49,"text":""},{"time":41.49,"text":"Winter has come too late"},{"time":50.54,"text":"Too close beside me"},{"time":59.81,"text":"How can I chase away"},{"time":68.1,"text":"All these fears deep inside?"},{"time":75.33,"text":""},{"time":77.76,"text":"I'll wait, the signs to come"},{"time":86.12,"text":"I'll find a way"},{"time":91.52,"text":"I will wait, the time to come"},{"time":100.24,"text":"I'll find a way home"},{"time":109.28,"text":"My light shall be the moon"},{"time":118.14,"text":"And my path - the ocean"},{"time":127.08,"text":"My guide the morning star"},{"time":136.15,"text":"As I sail home to you"},{"time":144.24,"text":""},{"time":183.94,"text":"I'll wait, the signs to come"},{"time":191.99,"text":"I'll find a way"},{"time":197.39,"text":"I will wait, the time to come"},{"time":205.35,"text":"I'll find a way home"},{"time":211.88,"text":""},{"time":214.34,"text":"Who then, can warm my soul?"},{"time":223.01,"text":"Who can quell my passion?"},{"time":231.83,"text":"Out of these dreams - a boat"},{"time":240.66,"text":"I will sail home to you"},{"time":247.42,"text":""}],"plain":null}