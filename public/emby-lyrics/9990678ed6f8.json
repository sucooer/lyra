{"synced":[{"time":20,"text":"（）"},{"time":24,"text":"（）"},{"time":28,"text":"（2005年2月19日完成）"},{"time":32,"text":""},{"time":86.55,"text":""},{"time":87.28,"text":"（music）"},{"time":92.32,"text":""},{"time":93.32,"text":"[00:33.20]可不可以一直同一边"},{"time":95.18,"text":"[00:35.16]可不可以陪我聊聊天"},{"time":97.15,"text":"[00:37.10]可不可以不要偷偷垫着脚尖"},{"time":101.86,"text":"[00:42.04]凭着呼吸维持平衡"},{"time":103.52,"text":"[00:43.76]就怕一点点风吹草声"},{"time":105.39,"text":"[00:45.59]会把你的专心吹偏了几分"},{"time":110,"text":"[00:50.13]爱要荒到什么时候才能平稳"},{"time":114.29,"text":"[00:54.47]同手同脚是否保证能默契满分"},{"time":118.48,"text":"[00:58.78]一心一意一帆风顺"},{"time":122.3,"text":"[01:02.62]需要两颗同样重的心才能完成"},{"time":145.21,"text":""},{"time":173.49,"text":"[02:19.62][01:19.83]远在天边近在眼前多么的两小无猜"},{"time":178.74,"text":"[02:41.04][02:07.09][01:07.18]歪歪歪 飞起来"},{"time":180.23,"text":"[02:42.85][02:08.99][01:09.25]歪歪歪 的浪漫"},{"time":181.86,"text":"[02:44.90][02:11.02][01:11.36]自由自在寻找平衡在幸福的两端"},{"time":186.16,"text":"[02:49.21][02:15.38][01:15.70]歪歪歪 就明白"},{"time":188.21,"text":"[02:51.27][02:17.49][01:17.73]歪歪歪 别走开"},{"time":190.34,"text":"远在天边近在眼前跟我来玩翘翘板"},{"time":196.96,"text":""},{"time":199.28,"text":"（end）"},{"time":200.8,"text":""},{"time":202.96,"text":"歌词：潘汉民"}],"plain":null}